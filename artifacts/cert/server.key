# This file should contain a locally-generated private key for development HTTPS.
# DO NOT commit real private keys to version control.
#
# To generate a self-signed cert and key for local development, run:
#   openssl req -x509 -newkey rsa:2048 -keyout artifacts/cert/server.key \
#     -out artifacts/cert/server.crt -days 365 -nodes -subj "/CN=localhost"
#
# The generated files are excluded from version control via .gitignore.
