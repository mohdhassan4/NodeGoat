# This file should contain the server's RSA private key for HTTPS.
# DO NOT commit real private key material to version control.
#
# To generate a self-signed key for local development:
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout artifacts/cert/server.key -out artifacts/cert/server.crt \
#     -subj "/CN=localhost"
#
# For production, load the key from an environment variable or secrets manager.
#
# ROTATION REQUIRED: The previous private key that was stored here has been
# exposed in git history and must be considered compromised. Generate a new
# key pair and do not reuse the old key material.
